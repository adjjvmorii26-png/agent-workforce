# Copy to .env and fill in. All values are optional if workforce.yaml sets them.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Alternative providers (OpenAI-compatible chat completions endpoints):
# ANTHROPIC_BASE_URL / OPENROUTER_BASE_URL etc. are just OPENAI_BASE_URL values.
# e.g. OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: enable shell execution tool (DANGEROUS - sandbox only)
WORKFORCE_ALLOW_SHELL=false

# Optional: number of parallel workers
WORKFORCE_WORKERS=3

# Optional: max review iterations per task
WORKFORCE_MAX_ATTEMPTS=3

# Optional: working directory agents may read/write (defaults to ./workspace)
WORKFORCE_SANDBOX=workspace
